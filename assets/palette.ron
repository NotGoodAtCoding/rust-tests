        rustic_planks: (r: 0.48, g: 0.30, b: 0.18, a: 1.0, hex: "#7A4D2E", desc: "Worn workshop timber floor planks"),
        workbench_wood: (r: 0.40, g: 0.25, b: 0.15, a: 1.0, hex: "#664026", desc: "Central wrapping workbench tabletop"),
        birch_wood: (r: 0.92, g: 0.76, b: 0.62, a: 1.0, hex: "#EBC29E", desc: "Turned wood elf head beads"),
        walnut_leather: (r: 0.24, g: 0.16, b: 0.10, a: 1.0, hex: "#3D291A", desc: "Elf belts, straps, and wooden clog shoes"),
        pine_sign_board: (r: 0.55, g: 0.36, b: 0.18, a: 1.0, hex: "#8C5C2E", desc: "In-world directional signs and plaques"),
        tree_bark: (r: 0.30, g: 0.18, b: 0.10, a: 1.0, hex: "#4D2E1A", desc: "Outdoor snow pine tree trunks"),

