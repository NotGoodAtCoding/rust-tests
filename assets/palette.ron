        cast_iron: (r: 0.18, g: 0.18, b: 0.20, a: 1.0, hex: "#2E2E33", desc: "Hunger dial casing and feeding trough scale"),
        wrought_iron: (r: 0.12, g: 0.12, b: 0.14, a: 1.0, hex: "#1F1F24", desc: "Suspended candle chandeliers and window hinges"),
        sheet_metal: (r: 0.68, g: 0.72, b: 0.76, a: 1.0, hex: "#ADB8C2", desc: "Curved spawner/despawner conveyor ducts"),
        platform_metal: (r: 0.25, g: 0.25, b: 0.30, a: 1.0, hex: "#40404D", desc: "Present sending circular pad"),
        chute_void: (r: 0.06, g: 0.06, b: 0.08, a: 1.0, hex: "#0F0F14", desc: "Sub-floor recessed despawn darkness"),

        // --- Moose Anatomy ---
        moose_fur: (r: 0.24, g: 0.16, b: 0.10, a: 1.0, hex: "#3D291A", desc: "Rich woodland brown torso and cranium"),
        moose_muzzle: (r: 0.36, g: 0.26, b: 0.18, a: 1.0, hex: "#5C422E", desc: "Warm tan Roman snout bridge"),
        moose_nose: (r: 0.12, g: 0.10, b: 0.09, a: 1.0, hex: "#1F1A17", desc: "Dark prehensile nose pad"),
        moose_antler: (r: 0.78, g: 0.72, b: 0.60, a: 1.0, hex: "#C7B899", desc: "Ivory palmated antler tines"),
        moose_hoof: (r: 0.10, g: 0.08, b: 0.07, a: 1.0, hex: "#1A1412", desc: "Stilt leg cloven hooves"),
        moose_eye: (r: 0.04, g: 0.04, b: 0.05, a: 1.0, hex: "#0A0A0D", desc: "Glossy obsidian eyes"),

