// =============================================================================
// Santa's Workshop: Minimal & Impressionist Color Palette & Material Constants
// PLAN.md Principle 4: Minimal & Impressionist Visual Style
// =============================================================================

(
    palette: (
        // --- Festive Core ---
        festive_red: (r: 0.88, g: 0.12, b: 0.14, a: 1.0, hex: "#E01F24", desc: "Primary holiday red for caps, ribbon, and buttons"),
        pine_green: (r: 0.12, g: 0.42, b: 0.20, a: 1.0, hex: "#1F6B33", desc: "Evergreen foliage and elf tunic green"),
        snow_white: (r: 0.96, g: 0.96, b: 0.98, a: 1.0, hex: "#F5F5FA", desc: "Fluffy wool pom-poms, scarf trim, and snow"),
        gold_ribbon: (r: 0.95, g: 0.80, b: 0.15, a: 1.0, hex: "#F2CC26", desc: "Present ribbon bows and star accents"),
        hazard_yellow: (r: 0.92, g: 0.78, b: 0.12, a: 1.0, hex: "#EBC71F", desc: "Dispatch platform hazard border"),
        candy_cane_red: (r: 0.85, g: 0.12, b: 0.12, a: 1.0, hex: "#D91F1F", desc: "Candy cane striped stockings"),

        // --- Woods, Bark & Organic ---
        cabin_log: (r: 0.40, g: 0.25, b: 0.16, a: 1.0, hex: "#664029", desc: "Rustic timber log cabin exterior walls"),
        timber_beam: (r: 0.26, g: 0.16, b: 0.10, a: 1.0, hex: "#42291A", desc: "Heavy vaulted tie beams and rafters"),
