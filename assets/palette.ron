        toy_blue: (r: 0.20, g: 0.50, b: 0.80, a: 1.0, hex: "#3380CC", desc: "Raw un-wrapped toy cube blue"),
        terracotta_pot: (r: 0.72, g: 0.36, b: 0.20, a: 1.0, hex: "#B85C33", desc: "Windowsill ceramic flowerpot"),
        cocoa_red: (r: 0.85, g: 0.15, b: 0.15, a: 1.0, hex: "#D92626", desc: "Festive cocoa mug ceramic"),
