        candle_tallow: (r: 0.94, g: 0.92, b: 0.82, a: 1.0, hex: "#F0EBD1", desc: "Chandelier tallow wax candles"),
        candle_flame: (r: 1.00, g: 0.82, b: 0.25, a: 1.0, hex: "#FFD140", desc: "Procedural candle flame tips"),
        candle_glow: (r: 1.00, g: 0.78, b: 0.46, a: 1.0, hex: "#FFC775", desc: "Warm 2200K dynamic point light emission"),
